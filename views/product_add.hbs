{{#> layout}}

  <section>
    <h1>Добавить десерт</h1>

    <form
      action="/products"
      method="post"
      enctype="multipart/form-data"
    >
      <div>
        <label for="name">
          Название:
        </label>

        <input
          id="name"
          name="name"
          type="text"
          required
        >
      </div>

      <div>
        <label for="description">
          Описание:
        </label>

        <textarea
          id="description"
          name="description"
        ></textarea>
      </div>

      <div>
        <label for="price">
          Цена:
        </label>

        <input
          id="price"
          name="price"
          type="number"
          min="0"
          step="0.01"
          required
        >
      </div>

      <div>
        <label for="categoryId">
          Категория:
        </label>

        <select
          id="categoryId"
          name="categoryId"
          required
        >
          <option value="">
            Выберите категорию
          </option>

          {{#each categories}}
            <option value="{{id}}">
              {{name}}
            </option>
          {{/each}}
        </select>
      </div>

      <div>
        <label for="image">
          Изображение:
        </label>

        <input
          id="image"
          name="image"
          type="file"
          accept="image/*"
        >
      </div>

      <button type="submit">
        Добавить десерт
      </button>
    </form>

    <p>
      <a href="/products">
        Назад к каталогу
      </a>
    </p>
  </section>

  <hr>

  <section>
    <h2>Добавить категорию</h2>

    <form
      action="/products/categories"
      method="post"
    >
      <div>
        <label for="categoryName">
          Название:
        </label>

        <input
          id="categoryName"
          name="name"
          type="text"
          required
        >
      </div>

      <div>
        <label for="categoryDescription">
          Описание:
        </label>

        <textarea
          id="categoryDescription"
          name="description"
        ></textarea>
      </div>

      <button type="submit">
        Добавить категорию
      </button>
    </form>
  </section>

  <hr>

  <section>
    <h2>Управление категориями</h2>

    {{#each categories}}

      <article>
        <form
          action="/products/categories/{{id}}?_method=PATCH"
          method="post"
        >
          <div>
            <label>
              Название:
            </label>

            <input
              name="name"
              type="text"
              value="{{name}}"
              required
            >
          </div>

          <div>
            <label>
              Описание:
            </label>

            <textarea
              name="description"
            >{{description}}</textarea>
          </div>

          <button type="submit">
            Сохранить изменения
          </button>
        </form>

        <form
          action="/products/categories/{{id}}?_method=DELETE"
          method="post"
        >
          <button type="submit">
            Удалить категорию
          </button>
        </form>
      </article>

      <hr>

    {{else}}

      <p>
        Категорий пока нет.
      </p>

    {{/each}}
  </section>

{{/layout}}
