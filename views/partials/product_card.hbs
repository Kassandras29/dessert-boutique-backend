<article class="product__card">
  <h3 class="product__card_name">
    <a href="/products/{{id}}">
      {{name}}
    </a>
  </h3>

  {{#if description}}
    <p>
      {{description}}
    </p>
  {{/if}}

  <p>
    Категория:
    {{category.name}}
  </p>

  <p>
    Цена:
    {{price}} ₽
  </p>
</article>
