<section id="reviews">
  <h2>Отзывы наших клиентов</h2>

  {{#if isReviewsPage}}

    <div class="review-form-container">
      <a
        href="/reviews/add"
        class="btn btn-primary"
      >
        Оставить отзыв
      </a>
    </div>

    <section class="reviews-updates">
      <h3>Обновления отзывов</h3>

      <p id="reviewsConnectionStatus">
        Подключение к обновлениям...
      </p>

      <div
        id="reviewUpdates"
        class="reviews-dynamic"
      ></div>
    </section>

  {{/if}}

  {{#each reviews}}
    <article class="review dynamic-review">
      <h4>
        <a href="/reviews/{{id}}">
          Заказ {{dessert.name}}
        </a>
      </h4>

      <div class="review__content">
        <div class="review__text">
          {{text}}
        </div>
      </div>

      <p class="review__meta">
        <span class="review__author">
          {{customer.name}}
        </span>

        <span class="review__author-separator">
          ·
        </span>

        <time>
          {{createdAt}}
        </time>

        <span class="review__rating">
          {{rating}}/5
        </span>
      </p>
    </article>
  {{else}}
    <p>Отзывов пока нет.</p>
  {{/each}}
</section>
