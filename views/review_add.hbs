{{#> layout}}

  <section id="reviews">
    <h2>Отзывы наших клиентов</h2>

    <section class="review-form-container">
      <h3>Оставьте ваш отзыв</h3>

      <form
        id="reviewForm"
        class="review-form"
        action="/reviews"
        method="post"
      >
        <div class="form-group">
          <label for="dessertId">
            Какой десерт заказывали? *
          </label>

          <select
            id="dessertId"
            name="dessertId"
            required
          >
            <option value="">
              Выберите десерт
            </option>

            {{#each desserts}}
              <option value="{{id}}">
                {{name}}
              </option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label for="customerId">
            Ваше имя *
          </label>

          <select
            id="customerId"
            name="customerId"
            required
          >
            <option value="">
              Выберите клиента
            </option>

            {{#each customers}}
              <option value="{{id}}">
                {{name}}
              </option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label for="rating">
            Оценка *
          </label>

          <select
            id="rating"
            name="rating"
            required
          >
            <option value="">
              Выберите оценку
            </option>

            <option value="5">
              5 — Восхитительно
            </option>

            <option value="4">
              4 — Очень вкусно
            </option>

            <option value="3">
              3 — Хорошо
            </option>

            <option value="2">
              2 — Средне
            </option>

            <option value="1">
              1 — Не понравилось
            </option>
          </select>
        </div>

        <div class="form-group">
          <label for="text">
            Текст отзыва *
          </label>

          <textarea
            id="text"
            name="text"
            required
            minlength="10"
            rows="4"
            placeholder="Поделитесь впечатлениями..."
          ></textarea>
        </div>

        <div class="form-actions">
          <button
            type="submit"
            class="btn btn-primary"
          >
            Добавить отзыв
          </button>

          <button
            type="reset"
            class="btn btn-secondary"
          >
            Очистить
          </button>
        </div>
      </form>
    </section>
  </section>

{{/layout}}
