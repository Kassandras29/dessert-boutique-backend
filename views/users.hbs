{{#> layout}}

  <section class="users">
    <h1>Наши клиенты</h1>

    {{#each customers}}
      <article>
        <h2>
          <a href="/users/{{id}}">
            {{name}}
          </a>
        </h2>

        <p>Email: {{email}}</p>

        {{#if phone}}
          <p>Телефон: {{phone}}</p>
        {{/if}}
      </article>
    {{else}}
      <p>Клиентов пока нет.</p>
    {{/each}}

    <p>
      <a href="/users/add">Добавить клиента</a>
    </p>
  </section>

{{/layout}}