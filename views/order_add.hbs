{{#> layout}}

  <section>
    <h1>Создать заказ</h1>

    <form action="/orders" method="post">

      <p>
        <label for="customerId">
          Клиент:
        </label>

        <select
          id="customerId"
          name="customerId"
          required
        >
          {{#each customers}}
            <option value="{{id}}">
              {{name}} — {{email}}
            </option>
          {{/each}}
        </select>
      </p>

      <div id="orderItems">
        <div class="order-item">
          <p>
            <label>
              Десерт:

              <select
                name="items[0][dessertId]"
                required
              >
                {{#each desserts}}
                  <option value="{{id}}">
                    {{name}} — {{price}} ₽
                  </option>
                {{/each}}
              </select>
            </label>

            <label>
              Количество:

              <input
                type="number"
                name="items[0][quantity]"
                value="1"
                min="1"
                required
              >
            </label>

            <button
              type="button"
              class="remove-order-item"
              hidden
            >
              Удалить
            </button>
          </p>
        </div>
      </div>

      <p>
        <button
          type="button"
          id="addOrderItem"
        >
          Добавить ещё десерт
        </button>
      </p>

      <p>
        <button type="submit">
          Создать заказ
        </button>
      </p>

    </form>

    <p>
      <a href="/orders">
        Назад к заказам
      </a>
    </p>
  </section>

  <script>
    const itemsContainer = document.getElementById('orderItems');
    const addButton = document.getElementById('addOrderItem');

    function updateItemIndexes() {
      const items = itemsContainer.querySelectorAll('.order-item');

      items.forEach((item, index) => {
        const dessertSelect = item.querySelector('select');
        const quantityInput = item.querySelector(
          'input[type="number"]',
        );
        const removeButton = item.querySelector(
          '.remove-order-item',
        );

        dessertSelect.name = `items[${index}][dessertId]`;
        quantityInput.name = `items[${index}][quantity]`;

        removeButton.hidden = items.length === 1;
      });
    }

    addButton.addEventListener('click', () => {
      const firstItem = itemsContainer.querySelector('.order-item');
      const newItem = firstItem.cloneNode(true);

      newItem.querySelector('input[type="number"]').value = '1';

      itemsContainer.appendChild(newItem);

      updateItemIndexes();
    });

    itemsContainer.addEventListener('click', (event) => {
      if (!event.target.classList.contains('remove-order-item')) {
        return;
      }

      event.target.closest('.order-item').remove();

      updateItemIndexes();
    });

    updateItemIndexes();
  </script>

{{/layout}}
